[Unit]
Description=Microsoft Entra ID OAuth2 Captive Portal FastAPI Service
After=network.target nftables.service dnsmasq.service
Wants=nftables.service dnsmasq.service

[Service]
Type=simple
WorkingDirectory=/opt/captive-portal
EnvironmentFile=/opt/captive-portal/.env
ExecStart=/opt/captive-portal/venv/bin/uvicorn main:app --host 0.0.0.0 --port 3000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
