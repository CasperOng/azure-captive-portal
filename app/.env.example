# ---------------------------------------------------------------------------
# Copy to /opt/captive-portal/.env on the gateway, then: chmod 600 .env
# Restart with: systemctl restart captive-portal.service captive-admin.service
# ---------------------------------------------------------------------------

# ---- Microsoft Entra ID (OAuth2) application ----
# App registration -> Redirect URI must be http://localhost:3000/auth/callback
AZURE_CLIENT_ID=your-azure-client-id-here
AZURE_TENANT_ID=your-azure-tenant-id-here
AZURE_CLIENT_SECRET=your-azure-client-secret-here
REDIRECT_URI=http://localhost:3000/auth/callback

# ---- Session signing ----
# HMAC key for the OAuth `state` parameter and the admin session cookie.
# Generate:  python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=generate-a-real-32-byte-hex-secret

# ---- Demo mode ----
# When true, the login page exposes a "1-Click Demo Authorize" button that
# skips Microsoft auth and authorizes the client MAC directly.
# Set to false once real Entra ID credentials are configured.
DEMO_BYPASS_MODE=true

# ---- Admin panel (port 3001) ----
ADMIN_PASSWORD=change-this-to-a-strong-password
# Source networks permitted to reach the admin panel, comma-separated CIDRs.
# Requests from the captive VLAN are refused regardless of this setting.
ADMIN_ALLOW_NET=192.168.1.0/24
# Fallback limit in kbps used when adding a new device (0 = unlimited).
DEFAULT_BANDWIDTH_KBPS=0
